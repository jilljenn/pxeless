#cloud-config
autoinstall:
  version: 1
  identity:
    hostname: localhost
    username: candidat
    password: "$y$j9T$M8pOhdJXJomM/7Vc3cKxe/$LvbRXmH3k12LwI4ztmouQSxjecrNmMJjV5gbGRD0na2"  # concours
  interactive-sections:
    - storage
  keyboard:
    layout: fr
  locale: fr_FR
  package_update: true
  packages:
    - xubuntu-desktop
    - libreoffice
    - libreoffice-l10n-fr
    - codium
    # - xfce4  # Plus léger mais ne fonctionne pas
    - ocaml
    - inkscape
    - gimp
    - apache2
    - wget
    - htop
    - language-pack-fr
    - vim
    - emacs
    - python3-pyqt5
    - zeal
    - php-cli
    - sqlite3
    - git
    - gcc-10
    - build-essential
    - gdb
    - valgrind
    - gfortran
    - gprolog
    - python3-pip
    - graphviz
    - gnuplot
    - flex
    - ml-yacc
    - ragel
    - menhir
    - python-is-python3
    - python-dev-is-python3
    - subversion
    - opam
    - pkg-config
    - zlib1g-dev
    - libffi-dev
    - libgmp-dev
    - libzmq5-dev
    - evince
    - zerofree
    - manpages
    - manpages-dev
    - manpages-fr
    - manpages-fr-dev
    - glibc-doc
    - man-db
    - bash-completion
    - console-data
    - libapache2-mod-php8.3
    - plocate
    - nemo
    - rfkill
    - rdiff-backup
    - lsyncd
    - krb5-user
    - libpam-krb5
    - freeipa-client
    - nfs-common
    - autofs
    - chrony
    - xserver-xorg-input-kbd
    - iptables-persistent
  refresh-installer:
    update: false #touched
  ssh:
    allow-pw: no
    authorized-keys:
      - "ssh-rsa  mc@persephone"
      - "ssh-rsa  jj@pikachu"
    install-server: yes
  user-data:
    bootcmd:
      - modprobe -r iwlwifi
      - rfkill block all
    runcmd:
      - git clone https://gitlab.com/agreg-info/lab-architecture.git
      - "cd lab-architecture && bash ./scripts/install-machine.sh"
      - "cp /home/candidat/.ssh/authorized_keys /root/.ssh/authorized_keys"
    users:
      - homedir: /home/candidat
        lock_passwd: false
        name: candidat
        passwd: "$y$j9T$M8pOhdJXJomM/7Vc3cKxe/$LvbRXmH3k12LwI4ztmouQSxjecrNmMJjV5gbGRD0na2"  # concours
        shell: /bin/bash
  apt:
    sources:
      vscodium.list:
        key: |
